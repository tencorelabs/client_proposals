# ==============================================================================
# .gitignore for Client Proposals & Pitch Decks Repository
# TenCore Digital Labs
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Editor and IDE Files
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / IntelliJ / WebStorm
.idea/
*.iml
*.iws
*.ipr

# Antigravity & AI Agent directories
.gemini/
.agents/
.system_generated/
*.agent.log

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*~
.#*
#*#

# ------------------------------------------------------------------------------
# Office & Presentation Temp / Lock Files
# ------------------------------------------------------------------------------
# Microsoft Office lock files (PowerPoint, Word, Excel)
~$*.ppt
~$*.pptx
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx

# LibreOffice / OpenOffice lock files
.~lock.*.odt#
.~lock.*.ods#
.~lock.*.odp#

# Adobe lock files
*.idlk
*.lock

# ------------------------------------------------------------------------------
# Web / Frontend / Node Development (Presentations & Demos)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build & bundle artifacts
dist/
build/
out/
.cache/
.parcel-cache/
.vite/

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.p12
*.pfx
credentials.json
client_secret*.json
service-account*.json
token.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments (Research & Scripts)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Logs, Backups & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.patch
scratch/
